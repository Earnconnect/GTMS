# ---- Database (hosted Postgres: Neon / Supabase) ----
# Create a free Postgres DB and paste the connection string here.
# Neon example:    postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/gtms?sslmode=require
# Supabase example: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/gtms?sslmode=require"

# ---- Auth.js (NextAuth v5) ----
# Generate with:  npx auth secret   (or)  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Payments ----
# simulated = in-DB fake provider (no real money). stripe = live Stripe.
PAYMENT_PROVIDER="simulated"

# ---- Stripe (required when PAYMENT_PROVIDER=stripe) ----
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Dashboard → Developers → Webhooks → signing secret for /api/stripe/webhook
# Events to subscribe: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET="whsec_..."

# Full public URL of your app (used for Stripe Connect redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Platform economics (integer percent / cents / minutes) ----
PLATFORM_FEE_BPS="1000"        # platform fee in basis points (1000 = 10%)
MIN_PAYOUT_CENTS="500"         # minimum worker payout = $5.00
RESERVATION_TTL_MINUTES="30"   # how long a reserved unit is held
REVIEW_WINDOW_HOURS="72"       # auto-approve submissions after this many hours

# ---- Cron protection ----
CRON_SECRET="change-me-cron-secret"

# ---- Live video interviews (optional) ----
# If unset, interviews use a built-in simulated room. To enable REAL video,
# create a free Daily.co account (dashboard.daily.co) and paste the API key
# from Developers → API keys. Optionally set DAILY_DOMAIN to your Daily subdomain.
DAILY_API_KEY=""
DAILY_DOMAIN=""
